# Copy this file to .env.local for local dev, and add the same two values as
# Environment Variables when you import this project into Vercel.
# These are the PUBLISHABLE keys — safe to expose in client-side code; access
# control is enforced by Postgres Row Level Security, not by keeping this secret.

NEXT_PUBLIC_SUPABASE_URL=https://kcxnwehxdrzwwqizqnym.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_hcbZmlPoReIGBzeZvUVkXQ_nvMjyYth

# SECRET — server-only, never prefix this with NEXT_PUBLIC_. Powers the
# in-app coach chat (app/api/coach). Get a key from console.anthropic.com,
# add it as a Vercel Environment Variable (not committed here), and redeploy.
ANTHROPIC_API_KEY=

# SECRET — server-only. Powers the two scheduled check-ins (app/api/cron/*),
# which have no logged-in user and so need to bypass RLS: Supabase dashboard
# → Project Settings → API keys → reveal "service_role" → copy.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — any random string (e.g. `openssl rand -hex 24`). Vercel sends this
# back as a Bearer token when it fires a Cron Job, which is how app/api/cron/*
# tells a real cron firing apart from a random public GET.
CRON_SECRET=

# Push reminders (Settings > Reminders). A keypair identifies this server to
# browsers' push services. The PUBLIC key is safe to expose (it ships to the
# browser); the PRIVATE key is a secret — server-only, never NEXT_PUBLIC_.
# Generate your own with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
